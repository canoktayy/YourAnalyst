      "name": "Auth user",
      "id": "e0c550a7-cdd1-5317-8c50-e29df19599e6",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -440,
        560
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
