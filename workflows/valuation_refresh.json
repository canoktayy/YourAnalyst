    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- What the dashboard shows. Scan universes are priced by the analysis API.\nselect symbol from holding\nunion\nselect symbol from watchlist\norder by 1;",
        "options": {}
      },
      "name": "DB: stocks to price",
      "id": "509f8340-6145-5aff-a124-19a058f8800f",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
          "name": "YA Postgres (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "url": "=https://query1.finance.yahoo.com/v8/finance/chart/{{ encodeURIComponent($json.symbol) }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "range",
              "value": "1d"
            },
            {
              "name": "interval",
              "value": "1d"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 500
            }
          },
          "timeout": 10000
        }
      },
      "name": "API: get price (Yahoo)",
      "id": "2b2cc22e-5e42-5614-8a26-fa49dad4f904",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        -100
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Turn Yahoo responses into quote rows.\n// A failed or implausible quote becomes price = null: the upsert then keeps the\n// last good price, which the dashboard shows as 'stale' (or 'unavailable' if none).\nconst symbols = $('DB: stocks to price').all();\nconst now = Date.now();\n\nconst rows = $input.all().map((item, i) => {\n  const symbol = symbols[item.pairedItem?.item ?? i].json.symbol;\n  const meta = item.json?.chart?.result?.[0]?.meta;\n  const price = Number(meta?.regularMarketPrice);\n  const ts = Number(meta?.regularMarketTime) * 1000;\n  const ok = !!meta\n    && String(meta.symbol).toUpperCase() === symbol.toUpperCase()\n    && Number.isFinite(price) && price > 0\n    && /^[A-Z]{3}$/.test(meta.currency ?? '')\n    && Number.isFinite(ts) && ts <= now + 5 * 60 * 1000;\n  const prev = Number(meta?.chartPreviousClose ?? meta?.previousClose);\n  const err = item.json?.error;\n  return {\n    symbol,\n    price: ok ? price : null,\n    change_pct: ok && prev > 0 ? Math.round((price / prev - 1) * 1e6) / 1e4 : null,\n    currency: ok ? meta.currency : 'USD',\n    as_of: ok ? new Date(ts).toISOString() : null,\n    source: 'yahoo',\n    error: ok ? null : String(err?.message ?? err ?? 'invalid quote payload'),\n  };\n});\n\nconst failed = rows.filter(r => r.price === null);\nreturn [{ json: {\n  rows,\n  ok_count: rows.length - failed.length,\n  failed: failed.map(r => `${r.symbol}: ${r.error}`),\n} }];\n"
      },
      "name": "Keep only valid prices",
      "id": "94a26e32-caad-5273-a9a4-79fa2385d550",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        -100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into quote (symbol, price, change_pct, currency, as_of, source, fetched_at)\nselect r.symbol, r.price, r.change_pct, r.currency, r.as_of, r.source, now()\nfrom jsonb_to_recordset($1::jsonb)\n     as r(symbol text, price numeric, change_pct numeric, currency char(3), as_of timestamptz, source text)\non conflict (symbol) do update set\n    price      = coalesce(excluded.price, quote.price),\n    change_pct = case when excluded.price is null then quote.change_pct else excluded.change_pct end,\n    currency   = case when excluded.price is null then quote.currency   else excluded.currency   end,\n    as_of      = coalesce(excluded.as_of, quote.as_of),\n    source     = case when excluded.price is null then quote.source     else excluded.source     end,\n    fetched_at = case when excluded.price is null then quote.fetched_at else excluded.fetched_at end\nreturning symbol, price, as_of;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.rows) }}"
        }
      },
      "name": "DB: save prices",
      "id": "4fa04af4-fbbe-5e46-969a-c4efb29d590f",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        980,
        -100
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
          "name": "YA Postgres (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Currencies in use, plus common ones so the dashboard can always convert them.\nselect currency from asset\nunion select currency from liability\nunion select cost_currency from holding\nunion select base_currency from app_user\nunion select unnest(array['EUR', 'TRY', 'GBP']);",
        "options": {}
      },
      "name": "DB: currencies to convert",
      "id": "60d2e791-b0cb-57be-9148-0d3c1f587547",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        260,
        320
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
          "name": "YA Postgres (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// One request for all currencies in use (USD is the anchor, always 1).\nconst currencies = [...new Set(\n  $input.all().map(i => String(i.json.currency).trim().toUpperCase())\n)].filter(c => /^[A-Z]{3}$/.test(c) && c !== 'USD');\n\nreturn [{ json: { currencies, symbols: currencies.join(',') } }];\n"
      },
      "name": "Build FX request",
      "id": "e1cd87fc-0591-5a2a-b9a4-0526568541b3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        320
      ]
    },
    {
      "parameters": {
        "url": "https://api.frankfurter.dev/v1/latest",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "base",
              "value": "USD"
            },
            {
              "name": "symbols",
              "value": "={{ $json.symbols }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "name": "API: get FX rates (Frankfurter)",
      "id": "cce5a3ec-ad13-5554-96ef-0cff7cb17996",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        320
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Frankfurter returns units per 1 USD; the DB stores USD per 1 unit.\nconst res = $input.first().json;\nconst wanted = $('Build FX request').first().json.currencies;\n\nif (res.base !== 'USD') throw new Error(`Unexpected FX base: ${res.base}`);\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(res.date ?? '')) throw new Error(`Missing FX date: ${res.date}`);\n\nconst rates = res.rates ?? {};\nconst valid = c => Number.isFinite(Number(rates[c])) && Number(rates[c]) > 0;\n\nreturn [{ json: {\n  rows: wanted.filter(valid).map(c => ({\n    currency: c,\n    usd_per_unit: 1 / Number(rates[c]),\n    as_of: `${res.date}T00:00:00Z`,\n    source: 'frankfurter (ECB)',\n  })),\n  missing: wanted.filter(c => !valid(c)),\n} }];\n"
      },
      "name": "Keep only valid FX rates",
      "id": "dd3a7fc1-15d1-554a-a087-323f25d73c25",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $json.error ?? {};\nconst msg = String(err.message ?? err ?? 'FX request failed').slice(0, 1000);\nreturn [{ json: { log: {\n  workflow_name: $workflow.name,\n  node_name: 'API: get FX rates (Frankfurter)',\n  execution_id: String($execution.id),\n  event_id: null,\n  message: `FX fetch failed after retries, kept last rates (stale after 3 days): ${msg}`,\n} } }];\n"
      },
      "name": "FX failed: keep last rates",
      "id": "86b4ca61-ff34-525d-8bbe-aad36ea97617",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        520
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into error_log (workflow_name, node_name, execution_id, event_id, message)\nselect l->>'workflow_name', l->>'node_name', l->>'execution_id', l->>'event_id', l->>'message'\nfrom (select $1::jsonb as l) x\nreturning id;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.log) }}"
        }
      },
      "name": "DB: log FX failure",
      "id": "8f983c44-63b5-51b5-a64d-abc40ecbbc82",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1220,
        520
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
          "name": "YA Postgres (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into fx_rate (currency, usd_per_unit, as_of, source, fetched_at)\nselect r.currency, r.usd_per_unit, r.as_of, r.source, now()\nfrom jsonb_to_recordset($1::jsonb)\n     as r(currency char(3), usd_per_unit numeric, as_of timestamptz, source text)\non conflict (currency) do update set\n    usd_per_unit = excluded.usd_per_unit,\n    as_of        = excluded.as_of,\n    source       = excluded.source,\n    fetched_at   = excluded.fetched_at\nreturning currency, usd_per_unit, as_of;",
        "options": {
          "queryReplacement": "={{ JSON.stringify($json.rows) }}"
        }
      },
      "name": "DB: save FX rates",
      "id": "41b64ecb-292a-5c25-b620-aaa2cba5cc51",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1220,
        320
      ],
      "credentials": {
        "postgres": {
          "id": "yaPgLocal0000001",
          "name": "YA Postgres (local)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
