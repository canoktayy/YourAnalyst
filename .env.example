DB_USER=youranalyst
DB_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-long-random
WEBHOOK_URL=http://localhost:5678/
# Chat model id. Local LM Studio: qwen2.5-7b-instruct. Demo: an OpenRouter ':free' model id.
YA_LLM_MODEL=qwen2.5-7b-instruct
# Extra request fields for the chat model. Thinking models in LM Studio: {"reasoning_effort":"none"}. OpenRouter: {}
YA_LLM_EXTRA_BODY={}
# OpenAI-compatible LLM endpoint for the "YA LLM" credential. Default: LM Studio on the host.
YA_LLM_URL=http://host.docker.internal:1234/v1
YA_LLM_API_KEY=lm-studio
# Base of the execution links stored by the Error Workflow.
N8N_EDITOR_BASE_URL=http://localhost:5678
